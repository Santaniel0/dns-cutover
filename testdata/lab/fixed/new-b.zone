; Zone at the new provider (after fixes).
$ORIGIN example.test.
$TTL 3600
@                    IN SOA   ns1.newdns.test. hostmaster.example.test. 2026110903 7200 3600 1209600 300
@                    IN NS    ns1.newdns.test.
@                    IN NS    ns2.newdns.test.
@                    IN A     192.0.2.10
@                    IN MX    10 mail.example.test.
@                    IN TXT   "v=spf1 mx include:_spf.mailhost.test -all"
@                    IN CAA   0 issue "letsencrypt.org"
; proxied by the provider: the CNAME is answered with proxy addresses
www                  IN A     104.21.48.10
mail                 IN A     192.0.2.25
api                  IN A     192.0.2.30
api                  IN A     192.0.2.31
crm                  IN CNAME crm.saas-vendor.test.
billing              IN A     192.0.2.50
staging              IN A     10.0.0.5
_dmarc               IN TXT   "v=DMARC1; p=quarantine; rua=mailto:dmarc@example.test"
